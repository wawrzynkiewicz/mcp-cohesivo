{
    "name": "ibexa/mcp-cohesivo",
    "license": "proprietary",
    "type": "ibexa-bundle",
    "keywords": [
        "ibexa-dxp"
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://updates.ibexa.co"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ibexa/commerce": "~6.0.x-dev",
        "ibexa/rest": "~6.0.x-dev",
        "ibexa/seo": "~6.0.x-dev",
        "mcp/sdk": "^0.7.1",
        "psr/simple-cache": "^3.0",
        "symfony/config": "^7.4 || ^8.1",
        "symfony/dependency-injection": "^7.4 || ^8.1",
        "symfony/event-dispatcher": "^7.4 || ^8.1",
        "symfony/http-foundation": "^7.4 || ^8.1",
        "symfony/http-kernel": "^7.4 || ^8.1",
        "symfony/psr-http-message-bridge": "^7.4 || ^8.1",
        "symfony/yaml": "^7.4 || ^8.1"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.2",
        "deptrac/deptrac": "^3.0",
        "ibexa/behat": "~6.0.x-dev",
        "ibexa/code-style": "~2.1.0",
        "ibexa/phpstan": "~6.0.x-dev",
        "ibexa/rector": "~6.0.x-dev",
        "ibexa/test-core": "~6.0.x-dev",
        "matthiasnoback/symfony-dependency-injection-test": "^6.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/monolog-bundle": "^3.11 || ^4.0",
        "symfony/phpunit-bridge": "^7.4 || ^8.1"
    },
    "autoload": {
        "psr-4": {
            "Ibexa\\Bundle\\McpCohesivo\\": "src/bundle/",
            "Ibexa\\Contracts\\McpCohesivo\\": "src/contracts/",
            "Ibexa\\McpCohesivo\\": "src/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ibexa\\Tests\\Bundle\\McpCohesivo\\": "tests/bundle/",
            "Ibexa\\Tests\\Integration\\McpCohesivo\\": "tests/integration/",
            "Ibexa\\Tests\\McpCohesivo\\": "tests/lib/"
        }
    },
    "scripts": {
        "fix-cs": "php-cs-fixer fix --config=.php-cs-fixer.php --show-progress=dots",
        "check-cs": "@fix-cs --dry-run",
        "test": "phpunit -c phpunit.xml.dist",
        "test-integration": "phpunit -c phpunit.integration.xml",
        "phpstan": "phpstan analyse -c phpstan.neon",
        "deptrac": "php vendor/bin/deptrac analyse"
    },
    "scripts-descriptions": {
        "fix-cs": "Automatically fixes code style in all files",
        "check-cs": "Run code style checker for all files",
        "test": "Run automatic tests",
        "test-integration": "Run integration tests",
        "phpstan": "Run static code analysis",
        "deptrac": "Run Deptrac architecture testing"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "6.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    }
}